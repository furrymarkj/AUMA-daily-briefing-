# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Raw fetched responses (inspect/replay locally; not needed in the repo)
cache/

# Local review packet (generated by feedback.py packet; private working file)
review_packet.json

# Feedback database (feedback.py; ratings, notes, requests). Private by
# design: it is never committed. The public delivery-state database
# (state/briefing.db) must never hold free-text feedback.
feedback.db

# NOTE: state/briefing.db is INTENTIONALLY committed. It holds delivery
# history (what was already shown), which the daily Action needs to avoid
# repeating stories. docs/ is also committed — it is the published site.
